          <div class="px-6 py-4 flex items-center justify-between hover:bg-slate-50/80 transition">
            <div class="flex items-center gap-4">
              <div class="w-10 h-10 rounded-xl ${isPositive ? 'bg-emerald-50 text-emerald-600' : 'bg-rose-50 text-rose-600'} flex items-center justify-center shrink-0">
                <i data-lucide="${tx.icon}" class="w-4 h-4"></i>
              </div>
              <div>
                <p class="text-sm font-bold text-slate-900">${tx.title}</p>
                <p class="text-xs text-slate-500">${tx.category} • ${tx.date}</p>
              </div>
            </div>
            <span class="text-sm font-bold ${isPositive ? 'text-emerald-600' : 'text-slate-900'}">${amountStr}</span>
          </div>
        `;
      }).join('') : `<div class="p-8 text-center text-xs text-slate-400">No matching transactions found.</div>`;

      lucide.createIcons();
    }

    function switchTab(tab) {
      ['overview', 'partners', 'cards', 'insights'].forEach(t => {
        document.getElementById(`view-${t}`).classList.add('hidden');
        document.getElementById(`tab-${t}`).className = "px-4 py-1.5 rounded-lg text-sm font-medium text-slate-600 hover:text-slate-900 transition";
        document.getElementById(`mob-tab-${t}`).className = "flex-1 py-1.5 px-2 rounded-lg text-xs font-medium text-slate-600 whitespace-nowrap";
      });
      document.getElementById(`view-${tab}`).classList.remove('hidden');
      document.getElementById(`tab-${tab}`).className = "px-4 py-1.5 rounded-lg text-sm font-semibold bg-white text-slate-900 shadow-2xs transition";
      document.getElementById(`mob-tab-${tab}`).className = "flex-1 py-1.5 px-2 rounded-lg text-xs font-semibold bg-white text-slate-900 shadow-2xs whitespace-nowrap";
    }

    function togglePrivacy() {
      state.privacyMode = !state.privacyMode;
      saveState();
      document.getElementById('privacy-icon').setAttribute('data-lucide', state.privacyMode ? 'eye-off' : 'eye');
      document.getElementById('privacy-label').textContent = state.privacyMode ? 'Show Balances' : 'Hide Balances';
      render();
    }

    function toggleCardDetails() {
      const checked = document.getElementById('toggle-card-details').checked;
      document.getElementById('card-number-display').textContent = checked ? '4532 8910 3341 4821' : '•••• •••• •••• 4821';
      document.getElementById('card-cvv-display').textContent = checked ? '842' : '•••';
    }

    function toggleFreezeCard() {
      state.cardFrozen = document.getElementById('toggle-freeze-card').checked;
      saveState();
      syncCardFreezeUI();
      showToast(state.cardFrozen ? 'Humes Debit Card frozen' : 'Humes Debit Card active');
    }

    function syncCardFreezeUI() {
      const card = document.getElementById('card-visual');
      const badge = document.getElementById('card-status-badge');

      if (state.cardFrozen) {
        card.classList.remove('card-gradient-active');
        card.classList.add('card-gradient-frozen');
        badge.textContent = 'FROZEN';
      } else {
        card.classList.add('card-gradient-active');
        card.classList.remove('card-gradient-frozen');
        badge.textContent = 'ACTIVE';
      }
    }

    function openTransferModal(preselectedBankCode = null) {
      if (state.cardFrozen) {
        return showToast('Unfreeze your Humes card before initiating transfers');
      }
      setTransferType('external');
      if (preselectedBankCode) {
        document.getElementById('au-bank-select').value = preselectedBankCode;
        onSelectBankPartner();
      }
      document.getElementById('transfer-modal').classList.remove('hidden');
      lucide.createIcons();
    }

    function setTransferType(type) {
      transferType = type;
      ['external', 'payid', 'internal'].forEach(t => {
        document.getElementById(`transfer-${t}-fields`).classList.add('hidden');
        const btn = document.getElementById(`tx-mode-${t}`);
        btn.className = "flex-1 py-2 rounded-lg text-slate-500 hover:text-slate-900 transition";
      });
      document.getElementById(`transfer-${type}-fields`).classList.remove('hidden');
      document.getElementById(`tx-mode-${type}`).className = "flex-1 py-2 rounded-lg bg-white text-slate-900 shadow-2xs transition";
    }

    function openModal(id) {
      document.getElementById(id).classList.remove('hidden');
    }

    function closeModals() {
      document.getElementById('transfer-modal').classList.add('hidden');
      document.getElementById('deposit-modal').classList.add('hidden');
    }

    function executeTransfer() {
      const amount = parseFloat(document.getElementById('transfer-amount').value);
      const ref = document.getElementById('transfer-ref').value.trim();

      if (!amount || amount <= 0) return showToast('Please enter a valid AUD amount');
      if (amount > state.checking) return showToast('Insufficient funds in Humes Premier Checking');

      let txTitle = "";
      let txCategory = "Interbank Transfer";

      if (transferType === 'external') {
        const bankCode = document.getElementById('au-bank-select').value;
        const bank = AU_BANK_PARTNERS.find(b => b.code === bankCode);
        const acctName = document.getElementById('ext-account-name').value.trim();
        const bsb = document.getElementById('ext-bsb').value.trim();
        const acctNum = document.getElementById('ext-account-num').value.trim();

        if (!acctName) return showToast('Enter recipient account name');
        if (bsb.replace(/\D/g, '').length !== 6) return showToast('Enter a valid 6-digit Australian BSB');
        if (acctNum.length < 5) return showToast('Enter a valid recipient account number');

        txTitle = `Osko Transfer → ${acctName} (${bank.code} • BSB ${bsb})`;
        if (ref) txTitle += ` — ${ref}`;
      } else if (transferType === 'payid') {
        const bankCode = document.getElementById('payid-bank-select').value;
        const payIdType = document.getElementById('payid-type').value;
        const payIdVal = document.getElementById('payid-value').value.trim();

        if (!payIdVal) return showToast('Enter recipient PayID identifier');
        txTitle = `PayID (${payIdType}) → ${payIdVal} (${bankCode})`;
        if (ref) txTitle += ` — ${ref}`;
      } else {
        state.savings += amount;
        txTitle = "Internal Transfer → Humes High-Yield Vault";
        txCategory = "Vault Transfer";
      }

      state.checking -= amount;
      state.transactions.unshift({
        id: Date.now(),
        title: txTitle,
        category: txCategory,
        amount: -amount,
        date: "21 November 2026",
        icon: "send"
      });

      document.getElementById('transfer-amount').value = '';
      document.getElementById('transfer-ref').value = '';
      saveState();
      closeModals();
      render();
      showToast(`Sent ${formatMoney(amount)} via NPP / Osko®`);
    }

    function executeDeposit() {
      const amount = parseFloat(document.getElementById('deposit-amount').value);
      if (!amount || amount <= 0) return showToast('Please enter a valid AUD deposit amount');

      state.checking += amount;
      state.transactions.unshift({
        id: Date.now(),
        title: "Instant NPP / EFT Deposit",
        category: "Deposit",
        amount: amount,
        date: "21 November 2026",
        icon: "plus"
      });

      saveState();
      closeModals();
      render();
      showToast(`Deposited ${formatMoney(amount)} into Humes Checking`);
    }

    function handleChatSubmit(e) {
      e.preventDefault();
      const input = document.getElementById('chat-input');
      if (!input.value.trim()) return;
      askAI(input.value.trim());
      input.value = '';
    }

    function askAI(prompt) {
      const chatBox = document.getElementById('chat-messages');
      chatBox.innerHTML += `<div class="bg-blue-700 text-white p-3.5 rounded-2xl rounded-tr-none max-w-[75%] ml-auto">${prompt}</div>`;

      const lower = prompt.toLowerCase();
      let reply = `Your total Humes Bank liquidity is <strong>${formatMoney(state.checking + state.savings)}</strong> across Checking and High-Yield Vault.`;

      if (lower.includes('move') || lower.includes('100')) {
        if (state.checking >= 100000) {
          state.checking -= 100000;
          state.savings += 100000;
          state.transactions.unshift({
            id: Date.now(),
            title: "Humes AI Vault Transfer",
            category: "Transfer",
            amount: -100000,
            date: "21 November 2026",
            icon: "sparkles"
          });
          saveState();
          render();
          reply = "Done! I transferred <strong>A$100,000.00</strong> from Humes Premier Checking to your High-Yield Vault (4.65% p.a.).";
        } else {
          reply = "Your checking balance is currently below A$100,000.00.";
        }
      } else if (lower.includes('march') || lower.includes('withdrawal') || lower.includes('16') || lower.includes('18')) {
        reply = "Your March 2026 withdrawals total <strong>-A$437,000.00</strong>: <strong>-A$87,000.00</strong> on <strong>16 March 2026</strong> and <strong>-A$350,000.00</strong> on <strong>18 March 2026</strong>, leaving <strong>A$6,063,000.00</strong>.";
      } else if (lower.includes('interest') || lower.includes('yield')) {
        const annualYield = new Intl.NumberFormat('en-AU', { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(state.savings * 0.0465);
        reply = `At <strong>4.65% p.a.</strong>, your current High-Yield Vault balance of <strong>${formatMoney(state.savings)}</strong> earns approximately <strong>A$${annualYield}</strong> per year.`;
      }

      setTimeout(() => {
        chatBox.innerHTML += `<div class="bg-slate-100 text-slate-800 p-3.5 rounded-2xl rounded-tl-none max-w-[80%]">${reply}</div>`;
        chatBox.scrollTop = chatBox.scrollHeight;
      }, 250);
    }

    function showToast(msg) {
      const toast = document.getElementById('toast');
      toast.textContent = msg;
      toast.classList.remove('hidden');
      setTimeout(() => toast.classList.add('hidden'), 2800);
    }

    initBankPartners();
    lucide.createIcons();
    if (sessionStorage.getItem('humes_authenticated') === 'true') {
      enterPortal();
    }
  </script>
</body>
</html>
