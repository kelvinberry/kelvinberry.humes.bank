<!DOCTYPE html>
<html lang="en-AU">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Humes Bank — Secure Online Banking</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/lucide@latest"></script>
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');
    body {
      font-family: 'Inter', sans-serif;
      background-color: #f8fafc;
      color: #0f172a;
    }
    .hero-gradient {
      background: linear-gradient(135deg, #0f172a 0%, #1e293b 55%, #1e3a8a 100%);
    }
    .card-gradient-active {
      background: linear-gradient(135deg, #1d4ed8 0%, #1e3a8a 50%, #0f172a 100%);
    }
    .card-gradient-frozen {
      background: linear-gradient(135deg, #64748b 0%, #334155 100%);
    }
  </style>
</head>
<body class="min-h-screen flex flex-col">

  <!-- ========================================================= -->
  <!-- 1. AUTHENTICATION & 2FA GATE                              -->
  <!-- ========================================================= -->
  <div id="auth-screen" class="min-h-screen flex items-center justify-center p-4 hero-gradient">
    <div class="bg-white w-full max-w-md rounded-3xl p-8 shadow-2xl space-y-6">
      
      <!-- Brand Header -->
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-2.5">
          <div class="w-10 h-10 rounded-xl bg-blue-700 text-white flex items-center justify-center font-extrabold text-xl">H</div>
          <div>
            <h1 class="font-extrabold text-xl text-slate-900 leading-none">Humes Bank</h1>
            <p class="text-[11px] text-slate-500 mt-0.5">Private & Commercial Portal (AUD)</p>
          </div>
        </div>
        <span id="db-mode-badge" class="text-[11px] font-semibold bg-slate-100 text-slate-600 px-2.5 py-1 rounded-full">Local Vault</span>
      </div>

      <!-- STEP A: SIGN IN / REGISTER FORM -->
      <div id="auth-step-credentials" class="space-y-4">
        <div class="flex bg-slate-100 p-1 rounded-xl text-xs font-semibold">
          <button id="mode-signin" onclick="setAuthMode('signin')" class="flex-1 py-2 rounded-lg bg-white text-slate-900 shadow-2xs transition">Sign In</button>
          <button id="mode-register" onclick="setAuthMode('register')" class="flex-1 py-2 rounded-lg text-slate-500 hover:text-slate-900 transition">Open Account</button>
        </div>

        <form onsubmit="handleCredentialsSubmit(event)" class="space-y-4">
          <div id="register-name-field" class="hidden">
            <label class="text-xs font-semibold text-slate-600">Full Legal Name</label>
            <input id="auth-name" type="text" placeholder="LaWarren Patterson" class="w-full mt-1 p-3 rounded-xl border border-slate-200 text-sm bg-slate-50 focus:outline-none focus:ring-2 focus:ring-blue-600" />
          </div>

          <div>
            <label class="text-xs font-semibold text-slate-600">Email Address</label>
            <input id="auth-email" type="email" value="lawarren.patterson@humesbank.com.au" required class="w-full mt-1 p-3 rounded-xl border border-slate-200 text-sm bg-slate-50 focus:outline-none focus:ring-2 focus:ring-blue-600" />
          </div>

          <div>
            <label class="text-xs font-semibold text-slate-600">Password</label>
            <input id="auth-password" type="password" value="••••••••••••" required class="w-full mt-1 p-3 rounded-xl border border-slate-200 text-sm bg-slate-50 focus:outline-none focus:ring-2 focus:ring-blue-600" />
          </div>

          <button type="submit" id="auth-submit-btn" class="w-full py-3.5 rounded-xl bg-blue-700 hover:bg-blue-800 text-white font-semibold text-sm shadow-md transition">
            Continue to 2FA Verification
          </button>
        </form>
      </div>

      <!-- STEP B: 2FA VERIFICATION -->
      <div id="auth-step-2fa" class="hidden space-y-5">
        <div class="bg-blue-50 border border-blue-100 rounded-2xl p-4 text-xs text-blue-900 space-y-1">
          <p class="font-bold flex items-center gap-1.5">
            <i data-lucide="shield-check" class="w-4 h-4 text-blue-700"></i>
            Two-Factor Security Check
          </p>
          <p>We sent a 6-digit verification code to your registered device. Demo code: <strong id="demo-otp-display" class="font-mono text-sm">482910</strong></p>
        </div>

        <form onsubmit="handle2FASubmit(event)" class="space-y-4">
          <div>
            <label class="text-xs font-semibold text-slate-600">Enter 6-Digit Security Code</label>
            <input id="otp-input" type="text" maxlength="6" placeholder="482910" required class="w-full mt-1.5 p-3.5 rounded-xl border border-slate-200 text-center font-mono text-2xl tracking-[0.4em] font-bold bg-slate-50 focus:outline-none focus:ring-2 focus:ring-blue-600" />
          </div>

          <button type="submit" class="w-full py-3.5 rounded-xl bg-blue-700 hover:bg-blue-800 text-white font-semibold text-sm shadow-md transition">
            Verify & Unlock Dashboard
          </button>
          <button type="button" onclick="backToCredentials()" class="w-full text-xs text-slate-500 hover:text-slate-800 font-medium">
            ← Back to Sign In
          </button>
        </form>
      </div>

      <p class="text-[11px] text-center text-slate-400">Protected by Humes Bank Hardware Key & TLS 1.3</p>
    </div>
  </div>

  <!-- ========================================================= -->
  <!-- 2. AUTHENTICATED BANKING PORTAL                           -->
  <!-- ========================================================= -->
  <div id="portal-shell" class="hidden min-h-screen flex flex-col">
    
    <!-- Top Navigation Bar -->
    <header class="bg-white border-b border-slate-200 sticky top-0 z-30">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
        <div class="flex items-center gap-2.5">
          <div class="w-9 h-9 rounded-xl bg-blue-700 text-white flex items-center justify-center font-extrabold text-lg">H</div>
          <div>
            <span class="font-extrabold text-lg tracking-tight text-slate-900">Humes Bank</span>
            <span class="hidden sm:inline-block ml-2 text-[11px] font-semibold bg-blue-50 text-blue-700 px-2 py-0.5 rounded-full">AUD • NPP & Osko Enabled</span>
          </div>
        </div>

        <nav class="hidden md:flex items-center gap-1 bg-slate-100 p-1 rounded-xl">
          <button onclick="switchTab('overview')" id="tab-overview" class="px-4 py-1.5 rounded-lg text-sm font-semibold bg-white text-slate-900 shadow-2xs transition">Overview</button>
          <button onclick="switchTab('partners')" id="tab-partners" class="px-4 py-1.5 rounded-lg text-sm font-medium text-slate-600 hover:text-slate-900 transition">AU Bank Partners</button>
          <button onclick="switchTab('cards')" id="tab-cards" class="px-4 py-1.5 rounded-lg text-sm font-medium text-slate-600 hover:text-slate-900 transition">Cards & Security</button>
          <button onclick="switchTab('insights')" id="tab-insights" class="px-4 py-1.5 rounded-lg text-sm font-medium text-slate-600 hover:text-slate-900 transition">Insights & AI</button>
        </nav>

        <div class="flex items-center gap-2.5">
          <button onclick="togglePrivacy()" class="flex items-center gap-1.5 text-xs font-semibold text-slate-600 hover:text-slate-900 bg-slate-100 hover:bg-slate-200/70 px-3 py-2 rounded-xl transition">
            <i id="privacy-icon" data-lucide="eye" class="w-4 h-4"></i>
            <span id="privacy-label" class="hidden sm:inline">Hide Balances</span>
          </button>
          <button onclick="logout()" class="flex items-center gap-1.5 text-xs font-semibold text-rose-600 hover:bg-rose-50 px-3 py-2 rounded-xl transition" title="Lock Session">
            <i data-lucide="log-out" class="w-4 h-4"></i>
            <span class="hidden sm:inline">Sign Out</span>
          </button>
        </div>
      </div>

      <!-- Mobile Sub-Nav -->
      <div class="flex md:hidden border-t border-slate-100 px-3 py-2 gap-1.5 bg-slate-50 overflow-x-auto">
        <button onclick="switchTab('overview')" id="mob-tab-overview" class="flex-1 py-1.5 px-2 rounded-lg text-xs font-semibold bg-white text-slate-900 shadow-2xs whitespace-nowrap">Overview</button>
        <button onclick="switchTab('partners')" id="mob-tab-partners" class="flex-1 py-1.5 px-2 rounded-lg text-xs font-medium text-slate-600 whitespace-nowrap">AU Banks</button>
        <button onclick="switchTab('cards')" id="mob-tab-cards" class="flex-1 py-1.5 px-2 rounded-lg text-xs font-medium text-slate-600 whitespace-nowrap">Cards</button>
        <button onclick="switchTab('insights')" id="mob-tab-insights" class="flex-1 py-1.5 px-2 rounded-lg text-xs font-medium text-slate-600 whitespace-nowrap">Insights & AI</button>
      </div>
    </header>

    <!-- Main Content -->
    <main class="flex-1 max-w-6xl w-full mx-auto px-4 sm:px-6 py-8">

      <!-- VIEW 1: OVERVIEW -->
      <section id="view-overview" class="space-y-8">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div>
            <h1 id="welcome-heading" class="text-2xl font-bold text-slate-900">Welcome back, LaWarren Patterson</h1>
            <p class="text-sm text-slate-500">Humes Bank Premier Checking & High-Yield Vault (AUD)</p>
          </div>
          <div class="flex items-center gap-3">
            <button onclick="openTransferModal()" class="flex items-center gap-2 bg-blue-700 hover:bg-blue-800 text-white text-sm font-semibold px-4 py-2.5 rounded-xl shadow-xs transition">
              <i data-lucide="send" class="w-4 h-4"></i>
              Transfer to Any AU Bank
            </button>
            <button onclick="openModal('deposit-modal')" class="flex items-center gap-2 bg-white hover:bg-slate-50 text-slate-800 border border-slate-200 text-sm font-semibold px-4 py-2.5 rounded-xl shadow-2xs transition">
              <i data-lucide="plus" class="w-4 h-4"></i>
              Deposit Funds
            </button>
          </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
          <div class="lg:col-span-2 hero-gradient rounded-3xl p-6 sm:p-8 text-white shadow-lg flex flex-col justify-between relative overflow-hidden">
            <div class="absolute -right-12 -top-12 w-48 h-48 bg-blue-500/20 rounded-full blur-3xl"></div>
            <div>
              <div class="flex items-center justify-between">
                <span class="text-xs font-semibold uppercase tracking-wider text-blue-200">Total Humes Bank Liquidity (AUD)</span>
                <span class="text-xs font-semibold bg-emerald-500/20 text-emerald-300 px-3 py-1 rounded-full">4.65% p.a. Active</span>
              </div>
              <div id="total-balance" class="text-3xl sm:text-5xl font-extrabold tracking-tight mt-3">A$6,063,000.00</div>
            </div>

            <div class="grid grid-cols-2 gap-4 mt-8 pt-6 border-t border-white/15">
              <div>
                <p class="text-xs text-slate-300">Humes Premier Checking ••4821</p>
                <p id="checking-balance" class="text-lg sm:text-xl font-bold mt-1">A$1,063,000.00</p>
              </div>
              <div>
                <p class="text-xs text-slate-300">Humes High-Yield Vault ••9014</p>
                <p id="savings-balance" class="text-lg sm:text-xl font-bold mt-1">A$5,000,000.00</p>
              </div>
            </div>
          </div>

          <div class="bg-white rounded-3xl border border-slate-200 p-6 flex flex-col justify-between shadow-2xs">
            <div>
              <div class="flex items-center justify-between mb-4">
                <h2 class="text-sm font-bold text-slate-900">NPP / Osko Interbank Network</h2>
                <span class="text-xs font-semibold bg-emerald-50 text-emerald-700 px-2.5 py-0.5 rounded-full">28 AU Banks Live</span>
              </div>
              <div class="p-4 rounded-2xl bg-slate-900 text-white space-y-3">
                <div class="flex justify-between items-center text-xs text-slate-400">
                  <span>HUMES BSB: 802-985</span>
                  <span class="text-emerald-400 font-semibold">Instant Osko</span>
                </div>
                <p class="font-mono text-sm tracking-widest">ACCT: 4821 9044</p>
                <p class="text-[11px] text-slate-300">Direct clearing to CommBank, Westpac, ANZ, NAB, Macquarie & 23+ partners.</p>
              </div>
            </div>

            <div class="mt-6 pt-4 border-t border-slate-100 flex items-center justify-between">
              <span class="text-xs text-slate-500">View BSB directory</span>
              <button onclick="switchTab('partners')" class="text-xs font-bold text-blue-700 hover:underline">All AU Bank Partners →</button>
            </div>
          </div>
        </div>

        <div class="bg-white rounded-3xl border border-slate-200 shadow-2xs overflow-hidden">
          <div class="px-6 py-5 border-b border-slate-100 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
            <div>
              <h2 class="text-base font-bold text-slate-900">Recent Transactions</h2>
              <p class="text-xs text-slate-500">Real-time AUD ledger synced to LaWarren Patterson's profile</p>
            </div>
            <div class="relative">
              <i data-lucide="search" class="w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2"></i>
              <input id="tx-search" oninput="render()" type="text" placeholder="Filter transactions..." class="text-xs bg-slate-50 border border-slate-200 rounded-xl pl-9 pr-4 py-2 w-full sm:w-64 focus:outline-none focus:ring-2 focus:ring-blue-600" />
            </div>
          </div>
          <div id="transaction-list" class="divide-y divide-slate-100"></div>
        </div>
      </section>

      <!-- VIEW 2: AUSTRALIAN BANK TRANSFER PARTNERS -->
      <section id="view-partners" class="hidden space-y-6">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div>
            <h1 class="text-2xl font-bold text-slate-900">Australian Bank Transfer Partners</h1>
            <p class="text-sm text-slate-500">Connected via New Payments Platform (NPP), Osko® & Direct Entry (BSB)</p>
          </div>
          <div class="relative">
            <i data-lucide="search" class="w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2"></i>
            <input id="partner-search" oninput="renderPartnersDirectory()" type="text" placeholder="Search bank or BSB prefix..." class="text-xs bg-white border border-slate-200 rounded-xl pl-9 pr-4 py-2.5 w-full sm:w-72 focus:outline-none focus:ring-2 focus:ring-blue-600" />
          </div>
        </div>

        <!-- Filter Pills -->
        <div class="flex flex-wrap gap-2">
          <button onclick="filterPartnerTier('all')" id="tier-all" class="px-3.5 py-1.5 rounded-full text-xs font-semibold bg-blue-700 text-white transition">All Partners (28)</button>
          <button onclick="filterPartnerTier('Big Four')" id="tier-Big Four" class="px-3.5 py-1.5 rounded-full text-xs font-semibold bg-white border border-slate-200 text-slate-600 hover:text-slate-900 transition">Major Big Four</button>
          <button onclick="filterPartnerTier('Digital & Neo')" id="tier-Digital & Neo" class="px-3.5 py-1.5 rounded-full text-xs font-semibold bg-white border border-slate-200 text-slate-600 hover:text-slate-900 transition">Digital & Neobanks</button>
          <button onclick="filterPartnerTier('Regional & Mutual')" id="tier-Regional & Mutual" class="px-3.5 py-1.5 rounded-full text-xs font-semibold bg-white border border-slate-200 text-slate-600 hover:text-slate-900 transition">Regional & Mutuals</button>
        </div>

        <div id="partners-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          <!-- Populated dynamically -->
        </div>
      </section>

      <!-- VIEW 3: CARDS & SECURITY -->
      <section id="view-cards" class="hidden space-y-6">
        <div>
          <h1 class="text-2xl font-bold text-slate-900">Cards & Security Controls</h1>
          <p class="text-sm text-slate-500">Instant virtual controls for your Humes Bank Platinum Debit Card</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-start">
          <div id="card-visual" class="card-gradient-active rounded-3xl p-8 text-white shadow-xl aspect-[1.586/1] flex flex-col justify-between transition-all duration-300">
            <div class="flex justify-between items-center">
              <div class="flex items-center gap-2">
                <div class="w-7 h-7 rounded-lg bg-white/20 flex items-center justify-center font-bold text-sm">H</div>
                <span class="font-bold tracking-wider text-sm">HUMES BANK</span>
              </div>
              <span id="card-status-badge" class="text-xs bg-white/20 px-3 py-1 rounded-full font-semibold">ACTIVE</span>
            </div>

            <div>
              <p class="text-xs text-blue-200 mb-1">Card Number</p>
              <p id="card-number-display" class="font-mono text-xl sm:text-2xl tracking-widest">•••• •••• •••• 4821</p>
            </div>

            <div class="flex justify-between items-end">
              <div>
                <p class="text-[10px] text-blue-200 uppercase">Cardholder</p>
                <p id="card-holder-name" class="font-semibold tracking-wide text-sm">LAWARREN PATTERSON</p>
              </div>
              <div class="flex gap-6">
                <div>
                  <p class="text-[10px] text-blue-200 uppercase">Expires</p>
                  <p class="font-mono font-semibold text-sm">09/29</p>
                </div>
                <div>
                  <p class="text-[10px] text-blue-200 uppercase">CVV</p>
                  <p id="card-cvv-display" class="font-mono font-semibold text-sm">•••</p>
                </div>
              </div>
            </div>
          </div>

          <div class="bg-white rounded-3xl border border-slate-200 divide-y divide-slate-100 shadow-2xs">
            <div class="p-6 flex items-center justify-between">
              <div class="flex items-center gap-3.5">
                <div class="w-10 h-10 rounded-xl bg-blue-50 text-blue-700 flex items-center justify-center">
                  <i data-lucide="eye" class="w-5 h-5"></i>
                </div>
                <div>
                  <p class="text-sm font-bold text-slate-900">Reveal Card Credentials</p>
                  <p class="text-xs text-slate-500">Show full 16-digit card number and security code</p>
                </div>
              </div>
              <input type="checkbox" id="toggle-card-details" onchange="toggleCardDetails()" class="w-5 h-5 accent-blue-700 rounded cursor-pointer">
            </div>

            <div class="p-6 flex items-center justify-between">
              <div class="flex items-center gap-3.5">
                <div class="w-10 h-10 rounded-xl bg-sky-50 text-sky-600 flex items-center justify-center">
                  <i data-lucide="snowflake" class="w-5 h-5"></i>
                </div>
                <div>
                  <p class="text-sm font-bold text-slate-900">Freeze Debit Card</p>
                  <p class="text-xs text-slate-500">Immediately block new purchases and outgoing transfers</p>
                </div>
              </div>
              <input type="checkbox" id="toggle-freeze-card" onchange="toggleFreezeCard()" class="w-5 h-5 accent-blue-700 rounded cursor-pointer">
            </div>

            <div class="p-6 flex items-center justify-between">
              <div class="flex items-center gap-3.5">
                <div class="w-10 h-10 rounded-xl bg-slate-100 text-slate-700 flex items-center justify-center">
                  <i data-lucide="rotate-ccw" class="w-5 h-5"></i>
                </div>
                <div>
                  <p class="text-sm font-bold text-slate-900">Reset Account State</p>
                  <p class="text-xs text-slate-500">Restore A$6,063,000.00 balance and March 2026 ledger</p>
                </div>
              </div>
              <button onclick="resetDemoData()" class="text-xs font-bold text-blue-700 hover:underline">Reset Data</button>
            </div>
          </div>
        </div>
      </section>

      <!-- VIEW 4: INSIGHTS & AI -->
      <section id="view-insights" class="hidden space-y-6">
        <div>
          <h1 class="text-2xl font-bold text-slate-900">Financial Insights & Humes AI</h1>
          <p class="text-sm text-slate-500">Automated cash-flow tracking and instant account actions</p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
          <div class="bg-white rounded-3xl border border-slate-200 p-6 space-y-5 shadow-2xs">
            <h2 class="text-base font-bold text-slate-900">March 2026 Withdrawals (AUD)</h2>
            <div class="text-3xl font-extrabold text-slate-900">A$437,000.00</div>
            <div class="w-full h-3.5 bg-slate-100 rounded-full overflow-hidden flex">
              <div class="bg-blue-700 h-full" style="width: 80.1%" title="18 March 2026"></div>
              <div class="bg-amber-500 h-full" style="width: 19.9%" title="16 March 2026"></div>
            </div>
            <div class="space-y-3 pt-2 text-sm">
              <div class="flex justify-between items-center">
                <span class="flex items-center gap-2 text-slate-600"><span class="w-2.5 h-2.5 rounded-full bg-blue-700"></span>18 Mar 2026 Settlement</span>
                <span class="font-bold">A$350,000.00</span>
              </div>
              <div class="flex justify-between items-center">
                <span class="flex items-center gap-2 text-slate-600"><span class="w-2.5 h-2.5 rounded-full bg-amber-500"></span>16 Mar 2026 Withdrawal</span>
                <span class="font-bold">A$87,000.00</span>
              </div>
            </div>
          </div>

          <div class="lg:col-span-2 bg-white rounded-3xl border border-slate-200 p-6 flex flex-col h-[420px] shadow-2xs">
            <div class="flex items-center justify-between pb-4 border-b border-slate-100">
              <div class="flex items-center gap-2">
                <div class="w-7 h-7 rounded-lg bg-blue-700 text-white flex items-center justify-center">
                  <i data-lucide="sparkles" class="w-4 h-4"></i>
                </div>
                <span class="font-bold text-sm text-slate-900">Humes Bank AI Assistant</span>
              </div>
              <span class="text-[11px] font-medium text-slate-400">Live AUD Account Context</span>
            </div>

            <div id="chat-messages" class="flex-1 overflow-y-auto py-4 space-y-3 text-sm">
              <div class="bg-slate-100 text-slate-800 p-3.5 rounded-2xl rounded-tl-none max-w-[80%]">
                Welcome to Humes Bank AI, LaWarren. After deducting your <strong>A$350,000.00</strong> (18 March 2026) and <strong>A$87,000.00</strong> (16 March 2026) withdrawals from A$6,500,000.00, your total balance is <strong>A$6,063,000.00</strong>.
              </div>
            </div>

            <div class="flex flex-wrap gap-2 py-2 border-t border-slate-100">
              <button onclick="askAI('Move A$100,000 to High-Yield Vault')" class="text-xs bg-blue-50 hover:bg-blue-100 text-blue-700 font-semibold px-3 py-1.5 rounded-full transition">Move A$100k to Vault</button>
              <button onclick="askAI('Summary of March 2026 withdrawals')" class="text-xs bg-blue-50 hover:bg-blue-100 text-blue-700 font-semibold px-3 py-1.5 rounded-full transition">March Withdrawals</button>
              <button onclick="askAI('How much interest will I earn?')" class="text-xs bg-blue-50 hover:bg-blue-100 text-blue-700 font-semibold px-3 py-1.5 rounded-full transition">Estimate Annual Yield</button>
